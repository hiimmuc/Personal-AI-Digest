<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" defer=""></script>

<script>
(function () {
  var CHART_COLORS = [
    '#0969da','#8250df','#1a7f37','#bf8700','#cf222e',
    '#0a69da','#6e40c9','#2da44e','#d4a72c','#ff8182',
    '#54aeff','#bc8cff','#4ac26b','#fbd633','#ffaba8'
  ];

  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function gridColor() {
    return isDark() ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)';
  }

  function textColor() {
    return isDark() ? '#c9d1d9' : '#636e7b';
  }

  function initCharts() {
    var d = window._trendingChartData;
    if (!d || typeof Chart === 'undefined') return;

    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif';

    // ── Bar chart: repos per day ─────────────────────────────
    var barCtx = document.getElementById('reposPerDayChart');
    if (barCtx) {
      new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: d.reposByDay.labels,
          datasets: [{
            label: 'Trending Repos',
            data: d.reposByDay.data,
            backgroundColor: 'rgba(9, 105, 218, 0.75)',
            borderColor: 'rgba(9, 105, 218, 1)',
            borderWidth: 1,
            borderRadius: 4,
            borderSkipped: false,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) { return ' ' + ctx.parsed.y + ' repos'; }
              }
            }
          },
          scales: {
            x: {
              grid: { color: gridColor() },
              ticks: { color: textColor(), maxRotation: 45 }
            },
            y: {
              beginAtZero: true,
              grid: { color: gridColor() },
              ticks: { color: textColor(), stepSize: 1, precision: 0 }
            }
          }
        }
      });
    }

    // ── Doughnut chart: topic distribution ───────────────────
    var donutCtx = document.getElementById('topicDistChart');
    if (donutCtx && d.topicLabels.length > 0) {
      new Chart(donutCtx, {
        type: 'doughnut',
        data: {
          labels: d.topicLabels,
          datasets: [{
            data: d.topicData,
            backgroundColor: CHART_COLORS.slice(0, d.topicLabels.length),
            borderWidth: 2,
            borderColor: isDark() ? '#161b22' : '#ffffff',
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: '60%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: textColor(),
                boxWidth: 12,
                padding: 14,
                font: { size: 11 }
              }
            },
            tooltip: {
              callbacks: {
                label: function (ctx) {
                  var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                  var pct = total > 0 ? Math.round(ctx.parsed / total * 100) : 0;
                  return ' ' + ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                }
              }
            }
          }
        }
      });
    } else if (donutCtx) {
      donutCtx.parentElement.innerHTML = '<p class="chart-empty">Not enough topic data yet.</p>';
    }
  }

  // Chart.js loads deferred – wait for it
  function waitForChartJS(attempts) {
    if (typeof Chart !== 'undefined') { initCharts(); return; }
    if (attempts > 0) setTimeout(function () { waitForChartJS(attempts - 1); }, 250);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { waitForChartJS(20); });
  } else {
    waitForChartJS(20);
  }

  // Re-draw on theme change
  document.addEventListener('themechange', function () {
    if (window.Chart) Chart.instances && Object.values(Chart.instances).forEach(function (c) { c.destroy(); });
    setTimeout(initCharts, 100);
  });
})();
</script>

